# Google Sheets published CSV URL
# Steps to get this:
# 1. Create a Google Sheet with columns: date, category, players, percentages
# 2. File → Share → Publish to web → Sheet1 → CSV → Publish
# 3. Copy the URL and paste it here
VITE_SHEETS_CSV_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/pub?gid=0&single=true&output=csv
